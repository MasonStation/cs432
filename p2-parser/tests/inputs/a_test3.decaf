def int main() {
    int i;
    int s;
    int v;
    bool ok;

    // init globals via assignment (not in declarations)
    Arr[0] = 2;
    Arr[1] = 3;
    Arr[2] = 4;
    Arr[3] = 5;
    Arr[4] = 6;

    Flags[0] = true;
    Flags[1] = false;
    Flags[2] = true;

    // while + break/continue + array indexing
    i = 0;
    s = 0;
    while (i < 5) {
        if (Flags[i % 3]) {
            s = s + Arr[i];
            i = i + 1;
            continue;
        } else {
            i = i + 1;
        }
        if (i > 100) { break; }  // dead branch guard
    }

    // left-assoc arithmetic: 10 - 3 - 2 == (10 - 3) - 2 == 5
    v = 10 - 3 - 2;

    // unary minus and logical NOT precedence
    ok = !(false || (s < 0)) && ( -v < 0 );

    // function calls + nested subexprs test
    v = blend( s, twice(1, 2), 3 ) + twice(v, 1);

    // return an int (required for main)
    return v + (ok && true);
}