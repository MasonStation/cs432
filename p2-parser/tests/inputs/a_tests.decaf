// Arrays must be global in Decaf.
int Arr[5];
bool Flags[3];

def int twice(int z, int w) {
    int t;
    t = z + w;
    return t + t;           // simple param use
}

def int blend(int a, int b, int c) {
    int r;
    // precedence & associativity checks:
    // * and / before + and -, left-assoc for + and -
    r = a + b * c - 10 / 2;         // r = a + (b*c) - (10/2)
    r = r + (a - b) * (c + 1);      // explicit subexprs
    // boolean precedence: ! > && > ||
    // (a < b) || (c == 0) && !false  ->  (a<b) || ((c==0) && true)
    if ( (a < b) || (c == 0) && !false ) {
        r = r + 1;
    }
    return r;
}

def int main() {
    int i;
    int s;
    int v;
    bool ok;

    // init globals via assignment (not in declarations)
    Arr[0] = 2;
    Arr[1] = 3;
    Arr[2] = 4;
    Arr[3] = 5;
    Arr[4] = 6;

    Flags[0] = true;
    Flags[1] = false;
    Flags[2] = true;

    // while + break/continue + array indexing
    i = 0;
    s = 0;
    while (i < 5) {
        if (Flags[i % 3]) {
            s = s + Arr[i];
            i = i + 1;
            continue;
        } else {
            i = i + 1;
        }
        if (i > 100) { break; }  // dead branch guard
    }

    // left-assoc arithmetic: 10 - 3 - 2 == (10 - 3) - 2 == 5
    v = 10 - 3 - 2;

    // unary minus and logical NOT precedence
    ok = !(false || (s < 0)) && ( -v < 0 );

    // function calls + nested subexprs test
    v = blend( s, twice(1, 2), 3 ) + twice(v, 1);

    // return an int (required for main)
    return v + (ok && true);
}
