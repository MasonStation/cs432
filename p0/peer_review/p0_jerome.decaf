    print_str("\n");

    print_int(fib(2));
    print_str("\n");

    print_int(fib(3));
    print_str("\n");

    print_int(fib(4));
    print_str("\n");

    print_int(fib(5));
    print_str("\n");

    print_int(fib(6));
    print_str("\n");

    print_int(fib(7));
    print_str("\n");

    print_int(fib(8));
    print_str("\n");

    // IS_PRIME---------------------

    print_str("\nis_prime\n");

    print_bool(is_prime(0));   // expect false
    print_str("\n");

    print_bool(is_prime(1));   // expect false
    print_str("\n");

    print_bool(is_prime(2));   // expect true
    print_str("\n");

    print_bool(is_prime(3));   // expect true
    print_str("\n");

    print_bool(is_prime(4));   // expect false
    print_str("\n");

    print_bool(is_prime(5));   // expect true
    print_str("\n");

    print_bool(is_prime(6));   // expect false
    print_str("\n");

    print_bool(is_prime(7));   // expect true
    print_str("\n");

    print_bool(is_prime(8));   // expect false
    print_str("\n");

    print_bool(is_prime(9));   // expect false
    print_str("\n");

    print_bool(is_prime(10));  // expect false
    print_str("\n");

    // GCD---------------------

    print_str("\ngcd\n");

    print_int(gcd(1, 1));     // expect 1
    print_str("\n");

    print_int(gcd(2, 3));     // expect 1
    print_str("\n");

    print_int(gcd(4, 6));     // expect 2
    print_str("\n");

    print_int(gcd(8, 12));    // expect 4
    print_str("\n");

    print_int(gcd(9, 6));     // expect 3
    print_str("\n");

    print_int(gcd(14, 21));   // expect 7
    print_str("\n");

    print_int(gcd(25, 10));   // expect 5
    print_str("\n");

    print_int(gcd(17, 13));   // expect 1 (both primes)
    print_str("\n");

    print_int(gcd(100, 85));  // expect 5
    print_str("\n");

    print_int(gcd(81, 27));   // expect 27
    print_str("\n");

    // DRAW_TRIANGLE---------------------

    print_str("\ndraw_triangle\n");

    draw_triangle(0);   // expect nothing
    print_str("\n---\n");

    draw_triangle(1);   // expect 1 star
    print_str("\n---\n");

    draw_triangle(2);   // expect 2-row triangle
    print_str("\n---\n");

    draw_triangle(3);   // small triangle
    print_str("\n---\n");

    draw_triangle(4);   // base width 4
    print_str("\n---\n");

    draw_triangle(5);   // base width 5
    print_str("\n---\n");

    draw_triangle(6);   // base width 6
    print_str("\n---\n");

    draw_triangle(7);   // base width 7
    print_str("\n---\n");

    draw_triangle(8);   // base width 8
    print_str("\n---\n");

    draw_triangle(10);  // bigger triangle
    print_str("\n---\n");

}