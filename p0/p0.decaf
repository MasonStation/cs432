def int fact(int n)
{
    int count;
    int answer;
    answer = 1;
    count = 1;
    if (n == 0){return 1;}
    while (count <= n){
        answer = answer * count;
        count = count + 1;
    }
    return answer;
}

def int fib(int n)
{
    if (n == 0){return 0;}
    if (n == 1){return 1;}
    else {
        return fib(n-1) + fib(n-2);
    }
}

def bool is_prime(int n)
{
    int count;
    count = 2;
    if (n == 0){return false;}

    while (count < n){
        if (n % count == 0){return false;}
        count = count + 1;
    }
    return true;
}

def int gcd(int a, int b)
{
    int count;
    int s;
    int gcd;

    count = 1;
    s = a;
    if (b < a){s = b;}
    while (count < s){
        if (a % count == 0){
            if (b % count == 0){
                if (count > gcd){gcd = count;}
            }
        }
        count = count + 1;
    }
    return gcd;
}

int nums[100];

def int sum_nums(int len)
{
    int count;
    int total;
    init_nums();
    total = 0;
    count = 0;
    while (count < len){
        total = total + nums[count];
        count = count + 1;
    }
    return total;
}

def void sort_nums(int len)
{
    int i;
    i = 0;
    while (i < len){
        int j;
        j = i + 1;
        while (j < len){
            if (nums[j] < nums[i]){
                int temp;
                temp = nums[j];
                nums[j] = nums[i];
                nums[i] = temp;
            }
            j = j + 1;
        }
        i = i + 1;
    }
}



def void draw_triangle(int base)
{
    int count;
    if (base % 2 == 0){count = 2;}
    else {count = 1;}
    while (count <= base){
        int space;
        int i;
        int i2;
        space = (base - count) / 2;
        i = 0;
        while (i < space){
            print_str(" ");
            i = i + 1;
        }
        i2 = 0;
        while (i2 < count){
            print_str("#");
            i2 = i2 + 1;
        }
        i = 0;
        while (i < space){
            print_str(" ");
            i = i + 1;
        }
        print_str("\n");
        count = count + 2;
    }

}

def int main()
{
    init_nums();
    print_nums();
    sort_nums(5);
    print_str("\n\n");
    print_nums();
}

def void print_nums(){
    int count;
    count = 0;
    while (count < 100){
        print_int(nums[count]);
        print_str(" ");
        count = count + 1;
    }
    print_str(" ");
}

